# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Self-Hosted Jitsi Meet Domain for Ad-Free Multi-Speaker Debates
# Defaults to meet.globalorators.com
VITE_JITSI_DOMAIN="meet.globalorators.com"

# Backend API URL (Production VPS or Cloudflare Tunnel)
VITE_API_URL="https://meet.globalorators.com/api"

# Google OAuth & One Tap Authentication (Client ID & Secret)
VITE_GOOGLE_CLIENT_ID="664033502342-9sijfg71v3c0i0riah1hhhgdufalfvk5.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="664033502342-9sijfg71v3c0i0riah1hhhgdufalfvk5.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"

# SMTP Email Configuration (Passwordless Speaker OTP Verification)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=465
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
FROM_EMAIL="your-email@gmail.com"

# Shared token for the Jitsi tunnel watchdog to update the live-room domain
# (POST /api/system/jitsi-domain). Set the same value for the backend and the watchdog.
# Leave empty to disable remote domain updates.
JITSI_UPDATE_TOKEN=""
