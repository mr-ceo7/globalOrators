# Global Orators Self-Hosted Jitsi Environment Configuration
# Copy this file to .env and configure your public domain / IP.

# Directory where configuration files will be stored on the host
CONFIG=~/.jitsi-meet-cfg

# Exposed HTTP and HTTPS ports on the host
HTTP_PORT=80
HTTPS_PORT=443

# Public domain name for the Global Orators video chamber
PUBLIC_URL=https://meet.globalorators.com

# IP address of the host machine / VPS (Crucial for JVB WebRTC routing)
# Run `curl ifconfig.me` on your VPS to get this value
DOCKER_HOST_ADDRESS=127.0.0.1

# Automated Let's Encrypt SSL Configuration
# Set ENABLE_LETSENCRYPT=1 when deploying to a public server with DNS pointed
ENABLE_LETSENCRYPT=0
LETSENCRYPT_DOMAIN=meet.globalorators.com
LETSENCRYPT_EMAIL=coach@globalorators.com

# XMPP Internal Domains
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi

# Internal System Authentication Passwords
# Run ./setup.sh to automatically generate secure random passwords for these:
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=CHANGE_ME_JICOFO_SECRET
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=CHANGE_ME_JVB_SECRET
JVB_BREWERY_MUC=jvbbrewery

# Media Ports
JVB_PORT=10000
JVB_TCP_PORT=4443
JVB_TCP_HARVESTER_DISABLED=false
JVB_STUN_SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302

# Interface Settings: English default & no mobile app store banners
DEFAULT_LANGUAGE=en
DISABLE_DEEP_LINKING=true
TZ=UTC
